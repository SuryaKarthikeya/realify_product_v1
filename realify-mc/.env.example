# Realify prototype — environment configuration.
# Copy to ".env" (same folder as run.py) and fill in values:  cp .env.example .env
# config.py loads .env automatically. Shell exports override .env. Unset = fixture mode.
# Inline comments after a value are supported, but own-line comments are safest.

# ---- Modes (fixture = seeded data, live = real source) ----
MODE=fixture
MODE_KEEPA=live
# MODE_RECALLS=live
# MODE_NEWS=live
# MODE_TRENDS=live

# ---- Credentials ----
KEEPA_KEY=
ANTHROPIC_API_KEY=
# NEWS_API_KEY=

# ---- Marketplace ----
# One of: US GB DE FR JP CA CN IT ES IN MX BR
KEEPA_DOMAIN=IN

# ---- Recalls region (US | IN | BOTH) ----
RECALL_REGION=IN
# India live recalls need an open-data source (US CPSC works out of the box):
# DATA_GOV_IN_KEY=
# DATA_GOV_IN_RECALL_RESOURCE=

# ---- News (live needs NEWS_API_KEY from newsapi.org) ----
NEWS_QUERY=car accessories OR car cover OR dashcam
NEWS_COUNTRY=in

# ---- Trends (best-effort; pip install pytrends) ----
TRENDS_GEO=IN
TRENDS_TERMS=waterproof car cover,car dashcam,bike cover

# ---- Tuning ----
PULL_INTERVAL_HOURS=4
# L2_MODEL=claude-sonnet-4-6
# FIRST_PULL_BACKFILL_DAYS=30

# ---- Frontend integration (realifyAi SPA) ----
# The frontend's origin — Vite dev server locally, its real domain in prod.
# Feeds both the CORS allowlist and Stripe's Checkout redirect (billing.py
# app_base()), so success/cancel URLs land back in the SPA, not this backend.
APP_URL=http://localhost:5173

# Session cookie scope. Leave both unset for same-site local dev (localhost frontend +
# localhost backend). If the backend is exposed cross-site — e.g. shared via a dev tunnel
# (https://*.devtunnels.ms) to a frontend running elsewhere — the browser withholds the
# session cookie on cross-site XHR/fetch under the "lax" default, so every authenticated
# route 401s past the initial page load. Set both together in that case:
# SESSION_SAMESITE=none
# SESSION_HTTPS_ONLY=true

# POST /api/billing/signup (the public front-door signup) 503s until both of
# these are set — billing.enabled() requires stripe + both keys. Test-mode
# values: https://dashboard.stripe.com/test/apikeys (secret key),
# https://dashboard.stripe.com/test/prices (a recurring Price id).
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=

# ---- /superlogin operator back door (P0.9 gate) ----
# The back door mints paid accounts and is FAIL-CLOSED: with ADMIN_KEY_HASH unset it is disabled
# (GET /superlogin -> 404, POST /api/signup -> 404). Signup also requires an @realify.ai email.
# Generate the value (PBKDF2-HMAC-SHA256, never store the plaintext key):
#   python3 -c "from realify.routers.deps import admin_key_hash; print(admin_key_hash('YOUR-STRONG-KEY'))"
# ADMIN_KEY_HASH=

# ============================================================================================
# PROD / AGENCY LAUNCH VARS (R11 env-drift guard)
# --------------------------------------------------------------------------------------------
# When the agency console is on (AGENCY_CONSOLE=on) or REQUIRE_POSTGRES is set, the app runs in
# PROD/AGENCY MODE and boot-validates the vars below (realify/dbengine.assert_backend/assert_prod_env).
# A stale-backup restore has silently dropped these before (R9.1: AGENCY_CONSOLE reverted off;
# the mail incident: MAIL_DRIVER reverted to dev → superlogin OTPs went to ./.mailbox, never SES).
# Fail-closed policy: missing DATABASE_URL(→postgres) or MAIL_DRIVER ABORTS startup; a missing
# EMAIL_DOMAIN / REPLY_TO_ADDRESS warns loudly. Set ALL of them explicitly on the prod box.
#
# AGENCY_CONSOLE=on
# REQUIRE_POSTGRES=1                       # optional: force prod-mode even without the console flag
# Runtime DB — must be Postgres in prod (NEVER the mounted SQLite). Use the non-owner realify_app role:
# DATABASE_URL=postgresql+psycopg://realify_app:PASSWORD@your-rds-host:5432/realify
# Mail — MAIL_DRIVER MUST be 'ses' in prod ('dev' writes to ./.mailbox and never delivers):
# MAIL_DRIVER=ses
# EMAIL_DOMAIN=realifyai.app              # SES-verified sending domain (default: realifyai.app)
# REPLY_TO_ADDRESS=consent@realifyai.app  # must be a ROUTED mailbox (consent@/notifications@ forward; agencies@ does NOT)
# AWS_REGION=us-east-1                    # SES region; sending uses the EC2 instance role (no AWS keys in .env)
